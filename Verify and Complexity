function Fo(n,p,d)
    if d lt 0 then return 0; end if;
    return &+[(-1)^i*Binomial(n,i)*Binomial(n+d-p*i-1,d-p*i):i in [0..d div p]];
end function;

function Go(n,p,d)
    if d lt 0 then return 0; end if;
    return &+[(-1)^(d-p*i)*Binomial(n,d-p*i)*Binomial(n+i-1,i):i in [0..d div p]];
end function;

function To(n,m,p,d)
    if Type(p) eq RngIntElt then return To(n,m,[p,p],d); end if;
    return &+[Fo(n,p[1],d-2*i)*Go(m,p[2],i):i in [0..d div 2]];
end function;

function vdoopk(v,d,o1,o2,q)
    F:=GF(q);
    n:=v+d+o1+o2;
    m:=d+o1+o2;
    R:=PolynomialRing(F,n);
    T:=IdentityMatrix(F,n);
    T:=InsertBlock(T,RandomMatrix(F,v,m),1,v+1);
    T:=InsertBlock(T,RandomMatrix(F,d,o1+o2),v+1,v+d+1);
    T:=InsertBlock(T,RandomMatrix(F,o1,o2),v+d+1,v+d+o1+1);
    S:=IdentityMatrix(F,m);
    S:=InsertBlock(S,RandomMatrix(F,d,o1+o2),1,d+1);
    S:=InsertBlock(S,RandomMatrix(F,o1,o2),d+1,d+o1+1);
    L:=[&+[T[i,j]*R.j:j in [1..n]]:i in [1..n]];
    G:=[&+[Random(F)*R.i*R.j:j in [1..Min(k-1,i)],i in [1..k]]:k in [v+1..v+d]];
    G:=G cat [&+[Random(F)*R.i*R.j:j in [1..Min(v+d,i)],i in [1..v+d+o1]]:k in [1..o1]];
    G:=G cat [&+[Random(F)*R.i*R.j:j in [1..Min(v+d+o1,i)],i in [1..n]]:k in [1..o2]];
    G:=[Evaluate(g,L):g in G];
    return G;
end function;

function intervdoopk(v,d,o1,o2,q)
    F:=GF(q);
    n:=v+d+o1+o2;
    m:=d+o1+o2;
    G:=vdoopk(v,d,o1,o2,q);
    R:=Parent(G[1]);
    M:=[Matrix(F,[[j ge i select MonomialCoefficient(g,R.i*R.j) else 0:j in [1..n]]:i in [1..n]]):g in G];
    N:=[A+Transpose(A):A in M];
    repeat
        L1:=&+[Random(F)*A:A in N];
        L2:=&+[Random(F)*A:A in N];
    until IsUnit(L1) and IsUnit(L2);
    L1:=L1^(-1);
    L2:=L2^(-1);
    M1:=[Transpose(L1)*A*L1:A in M];
    M2:=[Transpose(L2)*A*L2:A in M];
    M3:=[Transpose(L1)*A*L2:A in N];
    G:=[&+[A[i,j]*R.i*R.j:i in [1..n],j in [1..n]]:A in M1 cat M2 cat M3];
    return G;
end function; 

function projdown(G,k)
    R:=Parent(G[1]);
    n:=Rank(R);
    F:=BaseRing(R);
    S:=PolynomialRing(F,n-k);
    X:=[S.i:i in [1..n-k]] cat [0:i in [n-k+1..n]];
    G:=[Evaluate(g,X):g in G];
    return G;
end function;

function hilver(v,d,o1,o2,q,k,kind)
    n:=v+d+o1+o2;
    m:=d+o1+o2;
    o:=o2;
    if kind eq "Inter" then 
        G:=intervdoopk(v,d,o1,o2,q);
        m:=3*m-2;
        o:=2*o2-(n-o2);
    else G:=vdoopk(v,d,o1,o2,q); end if;
    if k ne 0 then G:=projdown(G,k); end if;
    R:=Parent(G[1]);
    p:=Characteristic(R);
    P:=quo<R|Ideal([R.i^p:i in [1..n-k]])>;
    G:=ideal<P|[P!g:g in G]>;
    S<t>:=PolynomialRing(Integers());
    f:=S!(HilbertSeries(P)-HilbertSeries(G));
    return [[Coefficient(f,i):i in [0..(o-k)*(p-1)]],[Max(To(n-k,m,p,i),Fo((o-k),p,i)):i in [0..(o-k)*(p-1)]]];
end function;


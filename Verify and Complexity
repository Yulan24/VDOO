procedure clscplx(n,v,m,q)
    Q:=[1,1,1,1000];
    o:=n-v;
    A:=Log(2,3*(2*Log(2,q)^2+Log(2,q)));

    for k in [1..o-1] do
        if To(n-k,m,2,o-k) le 0 then
            C:=Floor(2*Log(2,Binomial(n-k,o-k))+A+Log(2,Binomial(v+2,2)));
            if C le Q[4] then 
                Q:=[1,k,o-k,C];
            end if;
        end if;
    end for;

    if Q eq [1,1,1,1000] then
        for l in [2..3] do
            p:=2^l;
            for k in [1..o-1] do
                for d in [2..(o-k)*(p-1)] do
                    if To(n-k,m,p,d) le 0 then
                        C:=Floor(2*Ilog2(Fo(n-k,p,d)-Fo(o-k,p,d)+1)+A+Log(2,Binomial(n-k+1,2)));
                        if C le Q[4] then 
                            Q:=[l,k,d,C];
                        end if;
                    end if;
                end for;
            end for;
            if Q ne [1,1,1,1000] then
                break;
            end if;
        end for;
    end if;

    if Q ne [1,1,1,1000] then
        printf "mod 2^%o, minus %o oil variables, solving degree is %o, complexity is %o\n", Q[1],Q[2],Q[3],Q[4];
    end if;
end procedure;
